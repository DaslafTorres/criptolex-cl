# Groq (free tier) — https://console.groq.com/keys
GROQ_API_KEY=

# Model + provider: groq (LLM answers) or extractive (no key, quotes best chunk)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=30

# Retrieval
TOP_K=5
RERANK=True
# ms-marco-TinyBERT-L-2-v2 (fast) or ms-marco-MiniLM-L-12-v2 (slower, CPU ~8s/query)
RERANK_MODEL=ms-marco-TinyBERT-L-2-v2
